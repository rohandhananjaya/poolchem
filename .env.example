# Poolbench environment variables.
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# On Vercel, set these in Project → Settings → Environment Variables instead.

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Local dev uses SQLite; the file is created by `npx prisma migrate dev`.
# In production this is a Supabase Postgres connection string instead — the
# schema/adapter picked to match are handled automatically (prisma.config.ts,
# src/lib/prisma.ts) based on whether this value starts with "postgres".
# Prefer Supabase's pooled connection string for a serverless target like Vercel.
#   Postgres example: postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Supabase — get these from your project's API settings
# (https://supabase.com/dashboard/project/_/settings/api).
# ---------------------------------------------------------------------------
# Both NEXT_PUBLIC_* values are exposed to the browser; the anon key is safe to ship.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only secret — NEVER prefix with NEXT_PUBLIC_ and never expose to the client.
# Used by scripts/seed.ts to provision the demo login via the Supabase Admin API.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ---------------------------------------------------------------------------
# Cloudflare Turnstile — bot protection on /signup and /login
# Get these from https://dash.cloudflare.com/?to=/:account/turnstile
# ---------------------------------------------------------------------------
# Public site key — safe to ship to the browser; renders the challenge widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x0000000000000000000000000000000AA"

# Server-only secret — NEVER prefix with NEXT_PUBLIC_ and never expose to the client.
# When EITHER of these two is unset, Turnstile is skipped entirely (widget doesn't
# render client-side, verification always passes server-side) so local dev isn't
# blocked. Set BOTH in production, from the same Cloudflare Turnstile widget.
#
# For local testing without a Cloudflare account, use Cloudflare's documented
# dummy pair (always passes): site key "1x00000000000000000000AA" / secret
# "1x0000000000000000000000000000000AA". Swap the site key for
# "3x00000000000000000000FF" to force the interactive checkbox, or
# "2x00000000000000000000AB" to force a failure, when testing the blocked path.
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# Master on/off switch — set to "false" to force Turnstile off everywhere (widget
# never renders, server verification always passes) without touching the keys
# above. Useful for isolating a Cloudflare-side issue (e.g. a widget config/
# hostname problem) from the app's integration code. Any other value, or unset,
# leaves the normal key-presence-based behavior described above in effect.
NEXT_PUBLIC_TURNSTILE_ENABLED="true"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the deployed app, used for absolute links (homeowner share
# links, OAuth redirects). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public privacy-policy and terms-of-service page URLs. Used by the sidebar
# footer links and the cookie-consent banner. Default to "/privacy" and "/terms"
# when unset — set these to point at externally hosted legal pages if needed.
NEXT_PUBLIC_PRIVACY_URL=/privacy
NEXT_PUBLIC_TERMS_URL=/terms

# ---------------------------------------------------------------------------
# Native app (Capacitor) — see capacitor.config.ts
# ---------------------------------------------------------------------------
# URL the native Android/iOS WebView loads (the deployed Next.js app — it is
# server-rendered and cannot be bundled). Set to the production Vercel URL for
# store builds, or a live https dev server for local testing. Baked into the
# native projects at `npx cap sync` time; re-sync after changing it.
# Falls back to NEXT_PUBLIC_APP_URL, then to a placeholder in capacitor.config.ts.
POOLBENCH_NATIVE_URL=https://poolbench.vercel.app

# ---------------------------------------------------------------------------
# Native push (FCM for Android, APNs for iOS) — see src/lib/push/*
# ---------------------------------------------------------------------------
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_ and never expose to the client.
# When unset, push providers are lazily skipped and sendPush is a silent no-op
# (visit-assignment notifications simply never fire). Configure only the platform(s)
# you ship.
#
# Android / Firebase Cloud Messaging (HTTP v1):
# JSON blob from Firebase Console → Project settings → Service accounts → Generate new
# private key. Passed to the server as the *literal JSON string* (FCM_SERVICE_ACCOUNT_JSON).
# Must be a service account with the "Firebase Cloud Messaging API" enabled in Google Cloud.
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#
# iOS / Apple Push Notification service (p8 key):
# APNS_KEY is the base64-encoded .p8 file content (cat AuthKey_XXXX.p8 | base64).
# APNS_TOPIC defaults to the bundle id (com.poolbench.app) when unset.
APNS_TEAM_ID="YOUR_APPLE_TEAM_ID"
APNS_KEY_ID="YOUR_APNS_KEY_ID"
APNS_KEY="base64-encoded-p8-key-content"
APNS_TOPIC="com.poolbench.app"
# "true" = sandbox (development) APNs, "false"/unset = production.
APNS_SANDBOX="false"

# ---------------------------------------------------------------------------
# Controls the number of items per page across all paginated list views
# (schedule, reports, pools). Defaults to 10 when unset.
PAGE_SIZE=10

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Default "from" address for transactional emails (overrideable per company).
EMAIL_FROM="noreply@poolbench.com"

# Dev
# ---------------------------------------------------------------------------
# Comma-separated list of origin hostnames/IPs allowed during next dev
# (e.g., "192.168.8.154,10.0.0.1"). Leave empty to allow none.
ALLOWED_DEV_ORIGINS=192.168.8.154

# ---------------------------------------------------------------------------
# Stripe — get these from https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
# Provide BOTH sets. Which one is used depends on the Sandbox / Live toggle
# in the admin UI (/admin/packages).
# Sandbox keys (prefix: sk_test_...)
STRIPE_SECRET_KEY_SANDBOX="sk_test_..."
STRIPE_WEBHOOK_SECRET_SANDBOX="whsec_test_..."
# Live keys (prefix: sk_live_...)
STRIPE_SECRET_KEY_LIVE="sk_live_..."
STRIPE_WEBHOOK_SECRET_LIVE="whsec_live_..."

# ---------------------------------------------------------------------------
# PayPal — get these from https://developer.paypal.com/dashboard/applications
# ---------------------------------------------------------------------------
# Provide BOTH sets. Which one is used depends on the Sandbox / Live toggle
# in the admin UI (/admin/packages).
# Sandbox app credentials
PAYPAL_CLIENT_ID_SANDBOX="sb-..."
PAYPAL_CLIENT_SECRET_SANDBOX="sb-..."
PAYPAL_WEBHOOK_ID_SANDBOX="sb-..."
# Live app credentials
PAYPAL_CLIENT_ID_LIVE="live-..."
PAYPAL_CLIENT_SECRET_LIVE="live-..."
PAYPAL_WEBHOOK_ID_LIVE="live-..."

# ---------------------------------------------------------------------------
# Cloudflare R2 — object storage for company logo uploads.
# Get these from the Cloudflare dashboard: R2 → Manage R2 API Tokens
# (https://dash.cloudflare.com/?to=/:account/r2/api-tokens).
# ---------------------------------------------------------------------------
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_ and never expose to the client.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="poolbench-uploads"

# Public base URL for reading uploaded objects back out — a custom domain fronting
# the bucket (recommended over the *.r2.dev subdomain, which Cloudflare says isn't
# meant for production), no trailing slash. Must serve the bucket publicly
# (read-only, no auth) since logos render on unauthenticated pages
# (/report/[reportToken], /pool/[poolToken]). Also allow-listed in next.config.ts.
R2_PUBLIC_URL="https://logos.poolbench.com"
