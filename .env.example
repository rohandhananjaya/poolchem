# PoolChem environment variables.
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Local dev uses SQLite; the file is created by `npx prisma migrate dev`.
# When moving to Supabase Postgres, swap this for the pooled connection string
# and change the driver adapter in src/lib/prisma.ts (see CLAUDE.md).
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Supabase — get these from your project's API settings
# (https://supabase.com/dashboard/project/_/settings/api).
# Both are exposed to the browser (NEXT_PUBLIC_*); the anon key is safe to ship.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
