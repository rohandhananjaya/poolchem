# Poolbench environment variables.
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# On Vercel, set these in Project → Settings → Environment Variables instead.

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Local dev uses SQLite; the file is created by `npx prisma migrate dev`.
# When moving to Supabase Postgres, swap this for the pooled connection string
# and change the driver adapter in src/lib/prisma.ts (see CLAUDE.md).
#   Postgres example: postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Supabase — get these from your project's API settings
# (https://supabase.com/dashboard/project/_/settings/api).
# ---------------------------------------------------------------------------
# Both NEXT_PUBLIC_* values are exposed to the browser; the anon key is safe to ship.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only secret — NEVER prefix with NEXT_PUBLIC_ and never expose to the client.
# Used by scripts/seed.ts to provision the demo login via the Supabase Admin API.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the deployed app, used for absolute links (homeowner share
# links, OAuth redirects). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Controls the number of items per page across all paginated list views
# (schedule, reports, pools). Defaults to 10 when unset.
PAGE_SIZE=10

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Default "from" address for transactional emails (overrideable per company).
EMAIL_FROM="noreply@poolbench.app"

# Dev
# ---------------------------------------------------------------------------
# Comma-separated list of origin hostnames/IPs allowed during next dev
# (e.g., "192.168.8.154,10.0.0.1"). Leave empty to allow none.
ALLOWED_DEV_ORIGINS=192.168.8.154

# ---------------------------------------------------------------------------
# Stripe — get these from https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
# Server-only secret key (test mode: sk_test_..., live: sk_live_...)
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret from Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."
# Publishable key (exposed to browser, safe to ship)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---------------------------------------------------------------------------
# PayPal — get these from https://developer.paypal.com/dashboard/applications
# ---------------------------------------------------------------------------
# REST API app credentials
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."
# Webhook ID from PayPal Developer Dashboard → Webhooks
PAYPAL_WEBHOOK_ID="..."
# PayPal REST API base URL (sandbox: https://api-m.sandbox.paypal.com, live: https://api-m.paypal.com)
# Defaults to sandbox when not set.
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
