// Prisma schema for Poolbench — a multi-tenant pool service SaaS.
//
// Using SQLite for local development. We'll migrate to PostgreSQL/Supabase
// later; keep field types portable (avoid SQLite-only tricks).
//
// Prisma 7 note: the default generator is `prisma-client` (the successor to
// `prisma-client-js`) and it REQUIRES an explicit `output` path.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in `prisma.config.ts` (for Migrate) and is
// supplied to PrismaClient via a driver adapter — no `url` in this block.
datasource db {
  provider = "sqlite"
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  TECH
}

enum ServiceVisitStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  ISSUE
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PushPlatform {
  ANDROID
  IOS
}

/// A tenant. Every other record is scoped to a Company.
model Company {
  id                   String    @id @default(cuid())
  name                 String
  logo                 String?
  email                String
  phone                String?
  address              String?
  active               Boolean   @default(true)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  paypalSubscriptionId String?   @unique
  paypalPlanId         String?
  // Configurable "from" address for transactional emails (branding).
  // Falls back to the app-level default when null.
  fromEmail            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users User[]
  pools Pool[]
  invitations Invitation[]
  auditLogs AuditLog[]
  companyPackage CompanyPackage?
  invoices Invoice[]
  apiKeys ApiKey[]
  feedback Feedback[]
  pushDevices PushDevice[]

  @@map("companies")
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  // Supabase Auth user id — the primary bridge to the Supabase session.
  // Nullable/unique so legacy rows (created before this column existed) can
  // still be matched by email and backfilled on next sign-in.
  supabaseId String?   @unique
  name       String
  phone      String?
  role       UserRole  @default(TECH)
  companyId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Visits this user performed as the servicing tech.
  serviceVisits ServiceVisit[]

  feedback Feedback[]

  pushDevices PushDevice[]

  @@index([companyId])
  @@map("users")
}

model Pool {
  id        String   @id @default(cuid())
  name      String
  address   String?
  volume    Int // capacity in gallons
  image     String?
  qrCode    String   @unique
  // Unguessable token for the public, no-login homeowner dashboard
  // (/pool/[publicToken]). Distinct from qrCode, which techs scan in the field.
  publicToken      String  @unique @default(uuid())
  homeownerEmail   String?
  homeownerPhone   String?
  notes            String?
  companyId        String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  serviceVisits ServiceVisit[]

  @@index([companyId])
  @@map("pools")
}

model ServiceVisit {
  id           String             @id @default(cuid())
  poolId       String
  techId       String?
  notes        String?
  status       ServiceVisitStatus @default(DRAFT)
  weatherNotes      String?
  cancellationReason String?
  // Unguessable token for the public, no-login shareable report link
  // (/report/[publicToken]). Auto-generated for every visit.
  // Optional for backward-compat with existing rows; always populated for new
  // visits via the @default. Can be made required after backfilling existing rows.
  publicToken  String?            @unique @default(uuid())
  // When the visit is planned for. Null for visits created ad hoc (e.g. a tech
  // scanning a pool in the field); set when scheduled from the Schedule page.
  scheduledAt  DateTime?
  // Date the tech set for the next service when completing the report.
  // Null means no date was set; the report may still show a date from a future
  // scheduled visit.
  nextServiceDate DateTime?
  // Monotonic revision counter for this visit, incremented server-side on each
  // write so a stale/offline-replayed save can be detected by version.
  version        Int      @default(0)
  // UUID generated on-device for each queued offline save. Unique so a replayed
  // mutation is rejected server-side and deduped. Null for visits saved
  // online-only / before the offline epic.
  clientMutationId String? @unique
  // When the completed visit's shareable report email was first sent to the
  // homeowner. Set once inside the completion transaction so a retried offline
  // completion — even one with a fresh clientMutationId — can't double-email.
  // Null = report never notified.
  reportNotifiedAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  tech User? @relation(fields: [techId], references: [id], onDelete: SetNull)

  waterReadings   WaterReading[]
  chemicalsAdded  ChemicalAdded[]

  @@index([poolId])
  @@index([techId])
  @@index([scheduledAt])
  @@map("service_visits")
}

model WaterReading {
  id             String   @id @default(cuid())
  visitId        String
  ph             Float
  freeChlorine   Float
  totalAlkalinity Float
  calciumHardness Float
  cyanuricAcid   Float
  temperature    Float
  createdAt      DateTime @default(now())

  visit ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("water_readings")
}

model ChemicalAdded {
  id        String   @id @default(cuid())
  visitId   String
  name      String
  amount    Float
  unit      String
  createdAt DateTime @default(now())

  visit ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("chemicals_added")
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   String?
  stack     String?
  metadata  String?
  companyId String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@index([companyId])
  @@map("system_logs")
}

/// An invitation for a technician to join a company by setting their own password.
model Invitation {
  id        String   @id @default(cuid())
  email     String
  name      String
  role      UserRole @default(TECH)
  token     String   @unique @default(cuid())
  companyId String
  accepted  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([companyId])
  @@map("invitations")
}

// ── Package / subscription system ─────────────────────────────────

enum CompanyPackageStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  REFUNDED
}

/// A predefined plan/package that companies can subscribe to.
model Package {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  price        Int      // cents (e.g., 1900 = $19.00)
  features     String   // JSON string — parsed at runtime
  sortOrder    Int      @default(0)
  /// Cached, lazily-created Stripe Price id for this package — reused across
  /// checkouts/revisions instead of creating a fresh ephemeral price each time.
  stripePriceId String?
  /// Cached, lazily-created PayPal Billing Plan id for this package — reused
  /// across checkouts/revisions instead of creating a fresh plan each time.
  paypalPlanId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyPackages        CompanyPackage[]
  pendingForCompanies    CompanyPackage[] @relation("PendingPackage")
  invoices               Invoice[]

  @@map("packages")
}

/// Tracks which package a company is on and its subscription status.
/// `packageId` is null while a company is on trial and hasn't chosen a plan yet.
model CompanyPackage {
  id        String               @id @default(cuid())
  companyId String               @unique
  packageId String?
  status    CompanyPackageStatus @default(TRIAL)
  trialStart DateTime?
  trialEnd   DateTime?
  paidAt     DateTime?
  /// A scheduled downgrade's target package — set alongside `pendingEffectiveAt`,
  /// applied lazily once that date has passed (see getCompanyPackage).
  pendingPackageId   String?
  pendingEffectiveAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  package        Package? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  pendingPackage Package? @relation("PendingPackage", fields: [pendingPackageId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([packageId])
  @@index([pendingEffectiveAt])
  @@map("company_packages")
}

/// Single-row table for platform-wide, super-admin-editable settings.
model PlatformSettings {
  id             String   @id @default("singleton")
  trialDays      Int      @default(30)
  stripeEnabled  Boolean  @default(false)
  paypalEnabled  Boolean  @default(false)
  paymentDevMode Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@map("platform_settings")
}

/// Simulated billing records — created when a company "pays".
model Invoice {
  id          String        @id @default(cuid())
  companyId   String
  packageId   String
  amount      Int           // cents
  status      InvoiceStatus @default(PAID)
  paidAt      DateTime      @default(now())
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  @@index([companyId])
  @@index([packageId])
  @@map("invoices")
}

/// Tenant-scoped audit trail for user actions (who did what, when).
/// Separate from SystemLog which is for system diagnostics (errors/warnings).
model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ── API access (api_access plan feature) ──────────────────────────

/// A generated credential for the `/api/v1` REST API, scoped to one company.
/// The full secret is only ever known to the caller at creation time — only its
/// sha256 hash (for lookup) and a short display prefix are persisted.
model ApiKey {
  id         String    @id @default(cuid())
  companyId  String
  name       String
  // First ~12 chars of the raw secret, shown in the UI so an owner can tell
  // keys apart without ever seeing the full secret again after creation.
  keyPrefix  String
  // sha256 of the full secret. Looked up directly (unique), not compared —
  // no salt needed since the secret itself already has 192 bits of entropy.
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  usage   ApiKeyUsage[]

  @@index([companyId])
  @@map("api_keys")
}

/// Fixed 1-minute-window request counter per key, used to enforce API rate
/// limiting without any external cache/queue infrastructure.
model ApiKeyUsage {
  id          String   @id @default(cuid())
  apiKeyId    String
  windowStart DateTime // truncated to the minute
  count       Int      @default(0)

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, windowStart])
  @@map("api_key_usage")
}

// ── User feedback / support ────────────────────────────────────────

/// A user-submitted support request (bug report, feature request, or general
/// issue). Submissions are tenant-scoped: `companyId` records the submitting
/// user's company and is null only for company-less submitters (SUPER_ADMINs).
/// Super-admins triage these in /admin/feedback.
model Feedback {
  id          String         @id @default(cuid())
  type        FeedbackType
  title       String
  description String
  status      FeedbackStatus @default(OPEN)
  companyId   String?
  userId      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status, createdAt])
  @@map("feedback")
}

// ── Native push notifications (Capacitor) ─────────────────────────

/// A native device (Android/iOS) registered to receive push notifications for a
/// user. Tenant-scoped: `companyId` mirrors the owning user's company. Tokens
/// are provider-generated (FCM for Android, APNs for iOS) and rotate, so rows
/// are upserted on registration and deleted on sign-out/error.
model PushDevice {
  id        String       @id @default(cuid())
  userId    String
  companyId String
  platform  PushPlatform
  token     String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("push_devices")
}
