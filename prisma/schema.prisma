// Prisma schema for PoolChem — a multi-tenant pool service SaaS.
//
// Using SQLite for local development. We'll migrate to PostgreSQL/Supabase
// later; keep field types portable (avoid SQLite-only tricks).
//
// Prisma 7 note: the default generator is `prisma-client` (the successor to
// `prisma-client-js`) and it REQUIRES an explicit `output` path.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in `prisma.config.ts` (for Migrate) and is
// supplied to PrismaClient via a driver adapter — no `url` in this block.
datasource db {
  provider = "sqlite"
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  TECH
}

enum ServiceVisitStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A tenant. Every other record is scoped to a Company.
model Company {
  id                   String    @id @default(cuid())
  name                 String
  logo                 String?
  email                String
  phone                String?
  address              String?
  active               Boolean   @default(true)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users User[]
  pools Pool[]
  invitations Invitation[]
  auditLogs AuditLog[]

  @@map("companies")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  phone     String?
  role      UserRole  @default(TECH)
  companyId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Visits this user performed as the servicing tech.
  serviceVisits ServiceVisit[]

  @@index([companyId])
  @@map("users")
}

model Pool {
  id        String   @id @default(cuid())
  name      String
  address   String?
  volume    Int // capacity in gallons
  image     String?
  qrCode    String   @unique
  // Unguessable token for the public, no-login homeowner dashboard
  // (/pool/[publicToken]). Distinct from qrCode, which techs scan in the field.
  publicToken      String  @unique @default(uuid())
  homeownerEmail   String?
  homeownerPhone   String?
  notes            String?
  companyId        String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  serviceVisits ServiceVisit[]

  @@index([companyId])
  @@map("pools")
}

model ServiceVisit {
  id           String             @id @default(cuid())
  poolId       String
  techId       String?
  notes        String?
  status       ServiceVisitStatus @default(DRAFT)
  weatherNotes      String?
  cancellationReason String?
  // Unguessable token for the public, no-login shareable report link
  // (/report/[publicToken]). Auto-generated for every visit.
  // Optional for backward-compat with existing rows; always populated for new
  // visits via the @default. Can be made required after backfilling existing rows.
  publicToken  String?            @unique @default(uuid())
  // When the visit is planned for. Null for visits created ad hoc (e.g. a tech
  // scanning a pool in the field); set when scheduled from the Schedule page.
  scheduledAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  tech User? @relation(fields: [techId], references: [id], onDelete: SetNull)

  waterReadings   WaterReading[]
  chemicalsAdded  ChemicalAdded[]

  @@index([poolId])
  @@index([techId])
  @@index([scheduledAt])
  @@map("service_visits")
}

model WaterReading {
  id             String   @id @default(cuid())
  visitId        String
  ph             Float
  freeChlorine   Float
  totalAlkalinity Float
  calciumHardness Float
  cyanuricAcid   Float
  temperature    Float
  createdAt      DateTime @default(now())

  visit ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("water_readings")
}

model ChemicalAdded {
  id        String   @id @default(cuid())
  visitId   String
  name      String
  amount    Float
  unit      String
  createdAt DateTime @default(now())

  visit ServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@map("chemicals_added")
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   String?
  stack     String?
  metadata  String?
  companyId String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@index([companyId])
  @@map("system_logs")
}

/// An invitation for a technician to join a company by setting their own password.
model Invitation {
  id        String   @id @default(cuid())
  email     String
  name      String
  role      UserRole @default(TECH)
  token     String   @unique @default(cuid())
  companyId String
  accepted  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([companyId])
  @@map("invitations")
}

/// Tenant-scoped audit trail for user actions (who did what, when).
/// Separate from SystemLog which is for system diagnostics (errors/warnings).
model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([action])
  @@map("audit_logs")
}
